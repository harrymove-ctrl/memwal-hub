PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hub_william
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64url-encoded-32-byte-key
# Optional provider-contract override for local integration tests.
CLAUDE_PROFILE_URL=https://api.anthropic.com/api/oauth/profile
# Required for Gemini subscription OAuth. Keep the AGY client credential in the runtime secret store.
GEMINI_OAUTH_CLIENT_SECRET=replace-with-the-agy-oauth-client-secret
# Optional local/mock override. Production uses DeepSeek's official API by default.
# DEEPSEEK_API_URL=https://api.deepseek.com
# Shared only with the private apps/telegram Railway service. Generate a long random value.
TELEGRAM_SERVICE_TOKEN=replace-with-a-long-random-service-token
# SERV Reasoning Control Plane configuration (key from https://console.openserv.ai Settings→Keys)
SERV_REASONING_URL=https://inference-api.openserv.ai
SERV_REASONING_API_KEY=your-serv-api-key-here
SERV_REASONING_MODEL=gemini-3.8-flash
# Optional. Wallet recall stays unavailable, and invents no blob, until both are set.
# MEMWAL_DELEGATE_KEY=
# MEMWAL_ACCOUNT_ID=
