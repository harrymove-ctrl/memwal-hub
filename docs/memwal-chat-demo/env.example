# Copy to apps/api/.env.demo-local, fill in, then: chmod 600 apps/api/.env.demo-local
# Placeholders only. Never commit the filled file (.env.* is ignored by git).
PORT=8080
DATABASE_URL=postgres://postgres:<local-password>@127.0.0.1:55488/hub_william
FRONTEND_ORIGIN=http://127.0.0.1:5188
COOKIE_SECURE=false
# 32 random bytes, base64url without padding, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=<base64url 32-byte key>
# Required by the API at startup even when Gemini sign-in is not used.
GEMINI_OAUTH_CLIENT_SECRET=<placeholder or real client secret>
# Optional:
# MODEL_PROXY_ALLOW_LOCAL_HTTP=true          # allow http://localhost gateways for development
# MEMWAL_ALLOWED_RELAYERS=https://<relayer>  # extra relayers; the default is https://relayer.memory.walrus.xyz
#
# Not configured here on purpose: the ZRoute key, the Walrus Memory account ID and
# the delegate private key. Enter them in the app's masked dialogs; the API stores
# them encrypted per user.
#
# Frontend (apps/frontend/.env.local):
# VITE_API_BASE_URL=http://127.0.0.1:8080
